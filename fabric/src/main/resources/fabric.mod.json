{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "andi_makes"
  ],
  "contributors": [
    "agnor99",
    "Alveel",
    "poqli"
  ],
  "contact": {
    "sources": "https://github.com/SchmarrnDevs/Lighty",
    "issues": "https://github.com/SchmarrnDevs/Lighty/issues"
  },
  "license": "${license}",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.schmarrn.lighty.fabric.LightyFabric"
    ],
    "modmenu": [
      "dev.schmarrn.lighty.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": ">=26.1.2",
    "fabric-api": ">=0.137.0+1.21.10"
  }
}
