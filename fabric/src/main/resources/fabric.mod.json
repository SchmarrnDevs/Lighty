{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "andi_makes"
  ],
  "contributors": [
    "agnor99",
    "Alveel",
    "poqli"
  ],
  "contact": {
    "sources": "${repo_url}",
    "issues": "${repo_url}/issues"
  },
  "license": "${license}",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.schmarrn.lighty.fabric.LightyFabric"
    ],
    "modmenu": [
      "dev.schmarrn.lighty.fabric.ModMenuIntegration"
    ]
  },
  "accessWidener": "lighty.classtweaker",
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "fabric-api": "*",
    "java": ">=${java_version}"
  }
}
